    speakerName: <color=#4F88A4><link="wave:.5">The Mechanic</link></color>
    text: <link="wave:1.3"><color=#FFFFFF>Upgrades cost </color></link><color=#0079A6><link="wave:2">Currency</color>.
      </link> <color=#FFFFFF><link="wave:1.3><link="hold:.7">These starter ones'll
      cost</link> <link="wave:2"><color=#FFF500>Coins</color>. </link></link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerTag: 2
    speakerName: <color=#4F88A4><link="wave:.5">The Mechanic</link></color>
    text: <link="wave:1.3"><color=#FFFFFF>You collect </link><color=#FFF500><link="wave:2">Coins</color></link><link="wave:1.3">
      by finding 'em out on the roads</link><link="wave:1.3"> of the gauntlet. <link="hold:.7">I'll
      also give you coins based</link><link="wave:1.3"> off how far you can actually
      go!</color></link></link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerTag: 1
    speakerName: <color=#9EFF3B><link="wave:.5">{player_name}</link>
    text: <link="jitter"><color=#202020>...</color></link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerTag: 2
    speakerName: <color=#4F88A4><link="wave:.5">The Mechanic</link></color>
    text: <link="wave:1.3"><color=#FFFFFF>Well don't just sit there all silent! </link><link="hold:.7"><link="wave:1.3">Go
      out 'n try to beat the gauntlet!</link></link> <link="hold:.7"><link="wave:1.3">Come
      back to me when ya' got </link></color><link="wave:2><color=#FFF500>Coins</color></link><link="wave:1.3">
      <color=#FFFFFF>to spend!</link></link></color>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
