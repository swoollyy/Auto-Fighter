  - speakerTag: 2
    speakerName: <color=#4F88A4><link="wave:.5">The Mechanic</link></color>
    text: <link="wave:1.3"><color=#FFFFFF>'N just like that, <link="hold:.7">you
      can go further</link><link="wave:1.3"> 'long this trial!</link> <link="hold:.7">This
      is by far the easiest trial, </link><link="hold:.7">but...</link></link></color><link="hold:1"><link="jitter:1.5,
      spd=12"><size=86><color=#9A0000>The Overseer</link></size></color></link><link="wave:1.3"><color=#FFFFFF>
      won't make it a cake walk...</link></color>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerTag: 2
    speakerName: <color=#4F88A4><link="wave:.5">The Mechanic</link></color>
    text: <link="wave:1.3"><color=#FFFFFF>Upgrading skills past certain levels will</link><link="wave:1.3">
      unlock more skills to purchase!</link><link="hold:.7"><link="wave:1.3"> Soon
      enough, </link></link><link="hold:.7"><link="wave:1.3">you'll be able to</link></link>
      <link="wave:1.3">handle the toughest challenges</link></color> <link="jitter:1.5,
      spd=12"><size=86><color=#9A0000>The Overseer</link></color></size> <link="wave:1.3"><color=#FFFFFF>
      throws at'cha!</link></color>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerTag: 1
    speakerName: <color=#9EFF3B><link="wave:.5">{player_name}</link>
    text: <link="jitter:amp=1, spd=12"><color=#202020>...</color></link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerTag: 2
    speakerName: <color=#4F88A4><link="wave:.5">The Mechanic</link></color>
    text: <link="wave:1.3"><color=#FFFFFF>If you have more</color></link> <color=#FFF500><link="wave:2">Coins</link></color><link="wave:1.3">,
      <link="hold:.7">'git to spendin!</link></link><link="hold:.7"> If not,</link><link="hold:.7">
      well,</link><size=92><link="jitter:amp=3, spd=14"><color=#FFF100><link="hold:.7">The
      Asphalt Gauntlet</link></color></link><link="wave:1.3"><color=#FFFFFF> </size>ain't
      gonna beat itself!</link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerTag: 2
    speakerName: <color=#4F88A4><link="wave:.5">The Mechanic</link></color>
