%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e2f00befe1fee4a4bb665e496d2a78fc, type: 3}
  m_Name: Init_Dialogue
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Overseer
    text: <link="jitter"> Oh... <link="hold:0.5"> uhh... </link> </link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: '{player_name}'
    text: <link="jitter">...</link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: Overseer
    text: I'm- uhh.. not sure how ya got here, pal! You sure are lookin battered
      and bruised, though...
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: You
    text: <link="jitter">...</link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: Overseer
    text: Don't you worry! I'll patch you up in no time! How 'bout it!?
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: You
    text: <link="jitter">...</link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: Overseer
    text: Not much of a talker, are ya!? Well.. since ya gotta head back from wherever
      ya came from.. I'll patch ya right up! Gimme a second here...
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: You
    text: <link="jitter">...</link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: Overseer
    text: <link="jitter">...</link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: Overseer
    text: Allllright... you're lookin' right as rain! Brand spankin' new!
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: Overseer
    text: Again.. I'm really not sure how you ended up in this place.. Though, it
      ain't gonna be no picnic tryna get outta here. These roads ain't no joke...
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: You
    text: <link="jitter">...</link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: Overseer
    text: 'I''d be more than happy to guide you through on your journey. You randomly
      arriving in this world has me <link="jitter">ECSTATIC</link> '
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: Overseer
    text: 'Along with the necessary surgery, I''ve provided new parts that are <link="wave">extremmeelllyyyy</link>
      modifyable. Though, these modifications come with a fee... '
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: Overseer
    text: You can find coins spread all throughout the road... Heard the further
      you go, the more coins you'll bound to come across... even higher <link="wave"><link="rainbow">rarities</link></link>
      of coins, too.
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: You
    text: <link="jitter">...</link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: Overseer
    text: Well enough with all that talkin'! Let's get you accustomed to your new
      framework.
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  setStoryFlagOnComplete: init_finish
  pauseGameWhilePlaying: 1
  keepGameCanvasVisibleWhilePlaying: 0
