    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <color=#9A0000><link="wave:.5">???</link>
    text: <link="jitter:amp=1.3, spd=16"><color=#000000>You are next to challenge
      </link><size=92><link="jitter:amp=3, spd=14"><color=#FFF100>The Asphalt Gauntlet.</size></link></color>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <color=#9EFF3B><link="wave:.5">{player_name}</link>
    text: <link="jitter:amp=1, spd=12"><color=#202020>...</color></link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <color=#9A0000><link="wave:.5">The Overseer</link>
    text: </link><link="jitter:amp=1.3, spd=16"><color=#000000>I am</link></color>
      <link="wave:1.4"><size=86><color=#9A0000>The Overseer. </link></size></color><link=hold:1><link="jitter:amp=1.3,
      spd=16"><color=#000000>You are</link></color></link> <link="wave:1.4"><size=86><color=#9EFF3B>The
      Overseen. </link></size></color>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <color=#9EFF3B><link="wave:.5">{player_name}</link>
    text: <link="jitter:amp=1, spd=12"><color=#202020>...</color></link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <color=#9A0000><link="wave:.5">The Overseer</link>
    text: </link><link="jitter:amp=1.3, spd=16"><color=#000000>Throughout this trial,
      you will be given assistance from</link></color> <color=#ECB400><link=wave:1.4><size=72>The
      Help.</link></color></size><link="jitter:amp=1.3, spd=16"><color=#000000> They
      will make </link><link="jitter:amp=3, spd=14"><size=84><color=#FFF100>The Asphalt
      Gauntlet</size></link> <link="jitter:amp=1.3, spd=16"><color=#000000> less
      daunting.</link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <color=#9A0000><link="wave:.5">The Overseer</link>
    text: </link><link=wave:1.4><color=#4F88A4><size=72>The Mechanic </link></color></size><link="jitter:amp=1.3,
      spd=16"><color=#000000>will help you start your journey. </link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <color=#9A0000><link="wave:.5">The Overseer</link>
    text: <link="jitter:amp=1.3, spd=16"><color=#000000>You must complete the first
