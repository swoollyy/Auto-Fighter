    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <link="wave:1">???</link>
    text: <link="jitter:amp=1.3, spd=16"><color=#FF0000>You have been selected to
      participate in </link><size=92><link="jitter:amp=3, spd=14">The Asphalt Gauntlet.</size></link></color>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <link="wave:1">{player_name}</link>
    text: <link="jitter"><color=#4B4B4B>...</color></link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <link="wave:1">The Overseer</link>
    text: </link><link="jitter:amp=1.3, spd=16"><color=#FF0000>I am</link></color>
      <link="wave:1.4"><size=86><color=#9A0000>The Overseer. </link></size></color><link=hold:1><link="jitter:amp=1.3,
      spd=16"><color=#FF0000>You are</link></color></link> <link="wave:1.4"><size=86><color=#9A0000>The
      Overseen. </link></size></color>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <link="wave:1">{player_name}</link>
    text: <link="jitter"><color=#4B4B4B>...</color></link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <link="wave:1">The Overseer</link>
    text: </link><link="jitter:amp=1.3, spd=16"><color=#FF0000>Throughout this trial,
      you will be given assistance from</link></color> <color=#ECB400><link=wave:1.4><size=72>The
      Help.</link></color></size><link="jitter:amp=1.3, spd=16"><color=#FF0000> They
      will make </link><link="jitter:amp=3, spd=14"><size=84>The Asphalt Gauntlet</size></link>
      <link="jitter:amp=1.3, spd=16"> less troubling to complete. </link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  - speakerName: <link="wave:1">The Overseer</link>
    text: </link><link=wave:1.4><color=#4F88A4><size=72>The Mechanic </link></color></size><link="jitter:amp=1.3,
      spd=16"><color=#FF0000>will help you start your journey. </link><size=64><link="jitter:amp=1.6,
      spd=20"><b>BEGIN.</b></color></link>
    portrait: {fileID: 0}
    delayBeforeShow: 0
    autoAdvance: 0
    autoAdvanceSeconds: 0
  setStoryFlagOnComplete: init_finish
  pauseGameWhilePlaying: 1
  keepGameCanvasVisibleWhilePlaying: 0
